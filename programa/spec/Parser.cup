// ======================================
// Parser.cup
//
// @Entrada: Flujo de tokens del lexer
// @Salida:
//   - Arbol de analisis sintactico.
//   - Los errores sintacticos se reportan a compilador.ErrorReporter
//
// @Restricciones:
//   - Gramatica LALR(1) sin conflictos
//   - No se permite produccion generica
//   - La precedencia se resuelve con la estructura de la gramatica, no con delcaraciones precedence de CUP
//
// @objetivo: Definir los tokens y la gramática del lenguaje de programación definido en la especificación del proyecto
//
// ==========================================

package compilador.generated;

import java_cup.runtime.*;
import compilador.ErrorReporter;
import compilador.simbolos.Simbolo;
import compilador.simbolos.TablaSimbolos;
import compilador.simbolos.GestorTablas;

parser code {:
    public void syntax_error(Symbol sim) {
        ErrorReporter.sintactico("Se encontró '" + (sim.value != null ? sim.value : "?") + "'",
        sim.right, sim.left);
    }

    public void unrecovered_syntax_error(Symbol sim) {
        ErrorReporter.sintactico("Error no recuperable en '" + (sim.value != null ? sim.value : "?") + "'",
        sim.right, sim.left);
    }
:};

//  ===== Terminales =====

// Lit y Identificadores
terminal String LIT_INT, LIT_FLOAT, LIT_CHAR, LIT_STRING;
terminal String ID;

// Tipos
terminal INT, FLOAT, BOOL, CHAR, STRING;

// Reservados
terminal VAL, READ, WRITE;
terminal RETURN, BREAK;
terminal IF, ELIF, ELSE, WHILE, FOR;
terminal VOID, PRINCIPAL;

// Delimitadores
terminal OPEN_LLAVES, CLOSE_LLAVES;
terminal OPEN_PAREN, CLOSE_PAREN;
terminal OPEN_BRACKET, CLOSE_BRACKET;
terminal FIN_SENTENCIA;
terminal COMA;

// Asignación
terminal ASIGN;

// Aritméticos
terminal OP_SUMA, OP_RESTA, OP_MULT;
terminal OP_DIV_DECIMAL, OP_DIV_ENTERA;
terminal OP_MODULO, OP_POTENCIA;
terminal OP_INCREMENTO, OP_DECREMENTO;

// Relacionales
terminal OP_MENOR, OP_MENOR_IGUAL;
terminal OP_MAYOR, OP_MAYOR_IGUAL;
terminal OP_IGUAL, OP_DIFERENTE;

// Lógicos
terminal OP_AND, OP_OR, OP_NEGACION;

// Booleanos
terminal TRUE, FALSE;

// ++++++ No terminales ++++++++


non terminal programa;
non terminal elemento_programa_cm;
non terminal elemento_programa;
non terminal funcion;
non terminal funcion_principal;
non terminal String tipo_retorno;
non terminal java.util.ArrayList lista_parametros;
non terminal Simbolo var_simple;
non terminal Simbolo var_arreglo;
non terminal Simbolo var_no_arreglo;
non terminal String tipo_arrays;
non terminal String tipo_no_arreglo;
non terminal TablaSimbolos bloque;

// Declaraciones y asignaciones
non terminal declaracion_global;
non terminal creacion_simple;
non terminal creacion_asign;
non terminal asignacion;
non terminal creacion_arreglo;
non terminal Integer dimension_arreglo;
non terminal asignacion_arreglo;
non terminal Integer valores;
non terminal valor_arreglo;
non terminal valor_asignable;

// Literales y accesos
non terminal literal;
non terminal literal_numerico;
non terminal acceso_arreglo;
non terminal indice;

// Sentencias
non terminal sentencia;
non terminal lista_sentencias;
non terminal sentencia_var;
non terminal sentencia_expr;
non terminal expr_incremento;

// Lectura, escritura y flujo de control simple
non terminal sent_read;
non terminal sent_write;
non terminal sent_return;
non terminal sent_break;
non terminal arg_read;
non terminal arg_write;
non terminal expr_retorno;

// Estructuras de control
non terminal condicion;
non terminal sent_if;
non terminal sent_elif;
non terminal lista_elif;
non terminal sent_else;
non terminal sent_while;
non terminal sent_for;
non terminal for_inicio;
non terminal for_condicion;
non terminal for_actualizacion;

// Expresiones Aritméticas
non terminal expr_primaria;
non terminal expr_parentesis;
non terminal expr_negativo;
non terminal expr_potencia;
non terminal expr_aditiva;
non terminal expr_multiplicativa;
non terminal argumento_funcion;
non terminal lista_argumentos_funcion;
non terminal llamada_funcion;


// Relacionales - Lógicos
non terminal op_orden;
non terminal op_igualdad;
non terminal operando_rel;
non terminal expr_rel_orden;
non terminal expr_rel_igualdad;
non terminal expr_relacional;
non terminal op_logico;
non terminal operando_logico;
non terminal expr_negacion;
non terminal cadena_logica;
non terminal expr_logica;


// Placeholder para expresiones
non terminal expr_modulo;

start with programa;

// +_++++++++ Producciones ++++++++
tipo_retorno ::= INT {: RESULT = "int"; :}
    | FLOAT {: RESULT = "float"; :}
    | CHAR {: RESULT = "char"; :}
    | BOOL {: RESULT = "bool"; :}
    | STRING {: RESULT = "string"; :};

tipo_arrays ::= INT {: RESULT = "int"; :}
    | FLOAT {: RESULT = "float"; :};

tipo_no_arreglo ::= BOOL {: RESULT = "bool"; :}
    | STRING {: RESULT = "string"; :}
    | CHAR {: RESULT = "char"; :};

var_arreglo ::= tipo_arrays:t ID:id {: RESULT = new Simbolo(id, t, idleft, idright); :};

var_no_arreglo ::= tipo_no_arreglo:t ID:id {: RESULT = new Simbolo(id, t, idleft, idright); :};

var_simple ::= var_arreglo:v {: v.setCategoria(Simbolo.Categoria.PARAMETRO); GestorTablas.declarar(v); RESULT = v; :}
    | var_no_arreglo:v {: v.setCategoria(Simbolo.Categoria.PARAMETRO); GestorTablas.declarar(v); RESULT = v; :};

lista_parametros ::= var_simple:v COMA lista_parametros:l {: l.add(0, v); RESULT = l; :}
    | var_simple:v {: RESULT = new java.util.ArrayList(); RESULT.add(v); :};

bloque ::= OPEN_LLAVES:a lista_sentencias CLOSE_LLAVES:c {: RESULT = GestorTablas.cerrarBloque(aleft, aright, cleft, cright); :}
    | OPEN_LLAVES:a error CLOSE_LLAVES:c {: RESULT = GestorTablas.cerrarBloque(aleft, aright, cleft, cright); :};

funcion ::= tipo_retorno:t ID:id OPEN_PAREN:p lista_parametros:l CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarFuncion(b, id, idleft, idright, t, l, pleft, pright); :}
    | tipo_retorno:t ID:id OPEN_PAREN:p CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarFuncion(b, id, idleft, idright, t, new java.util.ArrayList(), pleft, pright); :};

funcion_principal ::= VOID PRINCIPAL:id OPEN_PAREN:p CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarPrincipal(b, idleft, idright, pleft, pright); :};

declaracion_global ::= creacion_simple
    | creacion_asign
    | creacion_arreglo;

// Recuperacion de errores en globales y encabezados de funcion.
elemento_programa ::= declaracion_global
    | funcion
    | error FIN_SENTENCIA
    | error bloque;

elemento_programa_cm ::= elemento_programa_cm elemento_programa
    | ;

// principal puede ir en cualquier posicion.
programa ::= elemento_programa_cm funcion_principal elemento_programa_cm {: GestorTablas.cerrarGlobal(); :};

expr_retorno ::= valor_asignable;

expr_modulo ::= expr_modulo OP_MODULO expr_multiplicativa
    | expr_multiplicativa;

expr_multiplicativa ::= expr_multiplicativa OP_MULT expr_aditiva
    | expr_multiplicativa OP_DIV_DECIMAL expr_aditiva
    | expr_multiplicativa OP_DIV_ENTERA expr_aditiva
    | expr_aditiva;

expr_aditiva ::= expr_aditiva  OP_SUMA expr_potencia
    | expr_aditiva  OP_RESTA expr_potencia
    | expr_potencia;

expr_potencia ::= expr_negativo OP_POTENCIA expr_potencia
    | expr_negativo;

expr_negativo ::= OP_RESTA literal_numerico
    | expr_primaria;

expr_primaria ::= literal
    | ID
    | acceso_arreglo
    | llamada_funcion
    | expr_incremento
    | expr_parentesis;

// Parentesis para agrupar y para operandos logicos.
expr_parentesis ::= OPEN_PAREN valor_asignable CLOSE_PAREN;


literal_numerico ::= LIT_INT
    | LIT_FLOAT;

argumento_funcion ::= valor_asignable;

lista_argumentos_funcion ::= argumento_funcion COMA lista_argumentos_funcion
    | argumento_funcion;

llamada_funcion ::= ID OPEN_PAREN lista_argumentos_funcion CLOSE_PAREN
    | ID OPEN_PAREN CLOSE_PAREN;

literal ::= literal_numerico
    | LIT_CHAR
    | LIT_STRING
    | TRUE
    | FALSE;

indice ::= expr_modulo;

acceso_arreglo ::= ID OPEN_BRACKET indice CLOSE_BRACKET;

valor_asignable ::= expr_modulo
    | expr_relacional
    | expr_logica;

creacion_simple ::= VAL var_arreglo:v FIN_SENTENCIA {: GestorTablas.declarar(v); :}
    | VAL var_no_arreglo:v FIN_SENTENCIA {: GestorTablas.declarar(v); :};

creacion_asign ::= VAL var_arreglo:v ASIGN valor_asignable FIN_SENTENCIA
        {: v.setInicializada(true); GestorTablas.declarar(v); :}
    | VAL var_no_arreglo:v ASIGN valor_asignable FIN_SENTENCIA
        {: v.setInicializada(true); GestorTablas.declarar(v); :};

asignacion ::= ID ASIGN valor_asignable FIN_SENTENCIA;

// Arreglo con tamaño, con o sin valores.
dimension_arreglo ::= OPEN_BRACKET LIT_INT:n CLOSE_BRACKET {: RESULT = Integer.parseInt(n); :};

creacion_arreglo ::= VAL var_arreglo:v dimension_arreglo:d FIN_SENTENCIA
        {: v.setCategoria(Simbolo.Categoria.ARREGLO); v.setDimension(d); GestorTablas.declarar(v); :}
    | VAL var_arreglo:v dimension_arreglo:d ASIGN OPEN_LLAVES valores CLOSE_LLAVES FIN_SENTENCIA
        {: v.setCategoria(Simbolo.Categoria.ARREGLO); v.setDimension(d); v.setInicializada(true); GestorTablas.declarar(v); :};

asignacion_arreglo ::= acceso_arreglo ASIGN valor_asignable FIN_SENTENCIA;

valor_arreglo ::= literal_numerico
    | OP_RESTA literal_numerico;

valores ::= valor_arreglo COMA valores:n {: RESULT = n + 1; :}
    | valor_arreglo {: RESULT = 1; :};

sentencia_expr ::= valor_asignable FIN_SENTENCIA;

expr_incremento ::= ID OP_INCREMENTO
    | ID OP_DECREMENTO;

arg_read ::= ID;

// write solo recibe literales o variables.
arg_write ::= literal
    | OP_RESTA literal_numerico
    | ID
    | acceso_arreglo;

sent_read ::= READ OPEN_PAREN arg_read CLOSE_PAREN FIN_SENTENCIA;

sent_write ::= WRITE OPEN_PAREN arg_write CLOSE_PAREN FIN_SENTENCIA;

// return siempre con expresion.
sent_return ::= RETURN expr_retorno FIN_SENTENCIA;

sent_break ::= BREAK FIN_SENTENCIA;

sentencia_var ::= creacion_simple
    | creacion_asign
    | asignacion
    | creacion_arreglo
    | asignacion_arreglo
    | sentencia_expr;

sentencia ::= sentencia_var
    | sent_return
    | sent_break
    | sent_read
    | sent_write
    | sent_if
    | sent_while
    | sent_for
    | bloque;

// error bloque: recupera sentencias mal formadas con bloque (ej. else sin if).
lista_sentencias ::= sentencia lista_sentencias
    | error FIN_SENTENCIA lista_sentencias
    | error bloque lista_sentencias
    | ;

op_orden ::= OP_MAYOR
    | OP_MENOR
    | OP_MAYOR_IGUAL
    | OP_MENOR_IGUAL;

op_igualdad ::= OP_IGUAL
    | OP_DIFERENTE;


// Permite anidar relacionales dentro de los corchetes.
operando_rel ::= OPEN_BRACKET valor_asignable CLOSE_BRACKET;

expr_rel_orden ::= operando_rel op_orden operando_rel;

expr_rel_igualdad ::= operando_rel op_igualdad operando_rel;

expr_relacional ::= expr_rel_orden
    | expr_rel_igualdad;

op_logico ::= OP_AND
    | OP_OR;

// Operando logico: entre parentesis o negacion.
operando_logico ::= expr_parentesis
    | expr_negacion;

expr_negacion ::= OP_NEGACION expr_parentesis;

// Permite encadenar operandos logicos.
cadena_logica ::= cadena_logica op_logico operando_logico
    | operando_logico op_logico operando_logico;

expr_logica ::= cadena_logica
    | expr_negacion;

// Recuperacion de errores dentro de la condicion.
condicion ::= OPEN_PAREN valor_asignable CLOSE_PAREN
    | OPEN_PAREN error CLOSE_PAREN;

sent_elif ::= ELIF:e condicion bloque:b {: GestorTablas.nombrar(b, "elif", eleft, eright); :};

lista_elif ::= lista_elif sent_elif
    | ;

sent_else ::= ELSE:e bloque:b {: GestorTablas.nombrar(b, "else", eleft, eright); :};

sent_if ::= IF:i condicion bloque:b lista_elif sent_else {: GestorTablas.nombrar(b, "if", ileft, iright); :}
    | IF:i condicion bloque:b lista_elif {: GestorTablas.nombrar(b, "if", ileft, iright); :};

sent_while ::= WHILE:w condicion bloque:b {: GestorTablas.nombrar(b, "while", wleft, wright); :};

// for є: inicio » condicion » actualizacion :э
for_inicio ::= VAL var_arreglo:v ASIGN valor_asignable
        {: v.setInicializada(true); GestorTablas.declarar(v); :}
    | VAL var_no_arreglo:v ASIGN valor_asignable
        {: v.setInicializada(true); GestorTablas.declarar(v); :}
    | ID ASIGN valor_asignable;

for_condicion ::= valor_asignable;

for_actualizacion ::= expr_modulo
    | ID ASIGN expr_modulo;

sent_for ::= FOR:f OPEN_PAREN for_inicio FIN_SENTENCIA for_condicion FIN_SENTENCIA for_actualizacion CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarFor(b, fleft, fright); :};
