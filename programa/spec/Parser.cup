// ======================================
// Parser.cup
//
// @Entrada: Flujo de tokens del lexer
// @Salida:
//   - Arbol de analisis sintactico.
//   - Los errores sintacticos se reportan a compilador.ErrorReporter
//
// @Restricciones:
//   - Gramatica LALR(1) sin conflictos
//   - No se permite produccion generica
//   - La precedencia se resuelve con la estructura de la gramatica, no con delcaraciones precedence de CUP
//
// @objetivo: Definir los tokens y la gramática del lenguaje de programación definido en la especificación del proyecto
//
// ==========================================

package compilador.generated;

import java_cup.runtime.*;
import compilador.ErrorReporter;
import compilador.simbolos.Simbolo;
import compilador.simbolos.TablaSimbolos;
import compilador.simbolos.GestorTablas;
import compilador.atributos.Codigo;
import compilador.atributos.Expr;
import compilador.atributos.Bloque;
import compilador.atributos.Rama;
import compilador.semantico.Semantico;
import compilador.tac.GeneradorTAC;

parser code {:
    public void syntax_error(Symbol sim) {
        ErrorReporter.sintactico("Se encontró '" + (sim.value != null ? sim.value : "?") + "'",
        sim.right, sim.left);
    }

    public void unrecovered_syntax_error(Symbol sim) {
        ErrorReporter.sintactico("Error no recuperable en '" + (sim.value != null ? sim.value : "?") + "'",
        sim.right, sim.left);
    }
:};

//  ===== Terminales =====

// Lit y Identificadores
terminal String LIT_INT, LIT_FLOAT, LIT_CHAR, LIT_STRING;
terminal String ID;

// Tipos
terminal INT, FLOAT, BOOL, CHAR, STRING;

// Reservados
terminal VAL, READ, WRITE;
terminal RETURN, BREAK;
terminal IF, ELIF, ELSE, WHILE, FOR;
terminal VOID, PRINCIPAL;

// Delimitadores
terminal OPEN_LLAVES, CLOSE_LLAVES;
terminal OPEN_PAREN, CLOSE_PAREN;
terminal OPEN_BRACKET, CLOSE_BRACKET;
terminal FIN_SENTENCIA;
terminal COMA;

// Asignación
terminal ASIGN;

// Aritméticos
terminal OP_SUMA, OP_RESTA, OP_MULT;
terminal OP_DIV_DECIMAL, OP_DIV_ENTERA;
terminal OP_MODULO, OP_POTENCIA;
terminal OP_INCREMENTO, OP_DECREMENTO;

// Relacionales
terminal OP_MENOR, OP_MENOR_IGUAL;
terminal OP_MAYOR, OP_MAYOR_IGUAL;
terminal OP_IGUAL, OP_DIFERENTE;

// Lógicos
terminal OP_AND, OP_OR, OP_NEGACION;

// Booleanos
terminal TRUE, FALSE;

// ++++++ No terminales ++++++++

non terminal Codigo programa;
non terminal Codigo elemento_programa_cm;
non terminal Codigo elemento_programa;
non terminal Codigo funcion;
non terminal Codigo funcion_principal;
non terminal String tipo_retorno;
non terminal java.util.ArrayList lista_parametros;
non terminal Simbolo var_simple;
non terminal Simbolo var_arreglo;
non terminal Simbolo var_no_arreglo;
non terminal String tipo_arrays;
non terminal String tipo_no_arreglo;
non terminal Bloque bloque;

// Declaraciones y asignaciones
non terminal Codigo declaracion_global;
non terminal Codigo creacion_simple;
non terminal Codigo creacion_asign;
non terminal Codigo asignacion;
non terminal Codigo creacion_arreglo;
non terminal Integer dimension_arreglo;
non terminal Codigo asignacion_arreglo;
non terminal java.util.ArrayList valores;
non terminal Expr valor_arreglo;
non terminal Expr valor_asignable;

// Literales y accesos
non terminal Expr literal;
non terminal Expr literal_numerico;
non terminal Expr acceso_arreglo;
non terminal Expr indice;

// Sentencias
non terminal Codigo sentencia;
non terminal Codigo lista_sentencias;
non terminal Codigo sentencia_var;
non terminal Codigo sentencia_expr;
non terminal Expr expr_incremento;

// Lectura, escritura y flujo de control simple
non terminal Codigo sent_read;
non terminal Codigo sent_write;
non terminal Codigo sent_return;
non terminal Codigo sent_break;
non terminal String arg_read;
non terminal Expr arg_write;
non terminal Expr expr_retorno;

// Estructuras de control
non terminal Expr condicion;
non terminal Codigo sent_if;
non terminal Rama sent_elif;
non terminal java.util.ArrayList lista_elif;
non terminal Codigo sent_else;
non terminal Codigo sent_while;
non terminal Codigo sent_for;
non terminal Codigo for_inicio;
non terminal Expr for_condicion;
non terminal Codigo for_actualizacion;

// Expresiones Aritméticas
non terminal Expr expr_primaria;
non terminal Expr expr_parentesis;
non terminal Expr expr_negativo;
non terminal Expr expr_potencia;
non terminal Expr expr_aditiva;
non terminal Expr expr_multiplicativa;
non terminal Expr argumento_funcion;
non terminal java.util.ArrayList lista_argumentos_funcion;
non terminal Expr llamada_funcion;


// Relacionales - Lógicos
non terminal String op_orden;
non terminal String op_igualdad;
non terminal Expr operando_rel;
non terminal Expr expr_rel_orden;
non terminal Expr expr_rel_igualdad;
non terminal Expr expr_relacional;
non terminal String op_logico;
non terminal Expr operando_logico;
non terminal Expr expr_negacion;
non terminal Expr cadena_logica;
non terminal Expr expr_logica;


// Placeholder para expresiones
non terminal Expr expr_modulo;

start with programa;

// +_++++++++ Producciones ++++++++
tipo_retorno ::= INT {: RESULT = "int"; :}
    | FLOAT {: RESULT = "float"; :}
    | CHAR {: RESULT = "char"; :}
    | BOOL {: RESULT = "bool"; :}
    | STRING {: RESULT = "string"; :};

tipo_arrays ::= INT {: RESULT = "int"; :}
    | FLOAT {: RESULT = "float"; :};

tipo_no_arreglo ::= BOOL {: RESULT = "bool"; :}
    | STRING {: RESULT = "string"; :}
    | CHAR {: RESULT = "char"; :};

var_arreglo ::= tipo_arrays:t ID:id {: RESULT = new Simbolo(id, t, idleft, idright); :};

var_no_arreglo ::= tipo_no_arreglo:t ID:id {: RESULT = new Simbolo(id, t, idleft, idright); :};

var_simple ::= var_arreglo:v {: v.setCategoria(Simbolo.Categoria.PARAMETRO); GestorTablas.declarar(v); RESULT = v; :}
    | var_no_arreglo:v {: v.setCategoria(Simbolo.Categoria.PARAMETRO); GestorTablas.declarar(v); RESULT = v; :};

lista_parametros ::= var_simple:v COMA lista_parametros:l {: l.add(0, v); RESULT = l; :}
    | var_simple:v {: RESULT = new java.util.ArrayList(); RESULT.add(v); :};

bloque ::= OPEN_LLAVES:a lista_sentencias:l CLOSE_LLAVES:c
        {: RESULT = new Bloque(GestorTablas.cerrarBloque(aleft, aright, cleft, cright), l); :}
    | OPEN_LLAVES:a error CLOSE_LLAVES:c
        {: RESULT = new Bloque(GestorTablas.cerrarBloque(aleft, aright, cleft, cright), Codigo.vacio()); :};

funcion ::= tipo_retorno:t ID:id OPEN_PAREN:p lista_parametros:l CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarFuncion(b.getTabla(), id, idleft, idright, t, l, pleft, pright);
           RESULT = GeneradorTAC.funcion(t, id, l, b.getCodigo()); :}
    | tipo_retorno:t ID:id OPEN_PAREN:p CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarFuncion(b.getTabla(), id, idleft, idright, t, new java.util.ArrayList(), pleft, pright);
           RESULT = GeneradorTAC.funcion(t, id, new java.util.ArrayList(), b.getCodigo()); :};

funcion_principal ::= VOID PRINCIPAL:id OPEN_PAREN:p CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarPrincipal(b.getTabla(), idleft, idright, pleft, pright);
           RESULT = GeneradorTAC.principal(b.getCodigo()); :};

declaracion_global ::= creacion_simple:c {: RESULT = c; :}
    | creacion_asign:c {: RESULT = c; :}
    | creacion_arreglo:c {: RESULT = c; :};

elemento_programa ::= declaracion_global:d {: RESULT = d; :}
    | funcion:f {: RESULT = f; :}
    | error FIN_SENTENCIA {: RESULT = Codigo.vacio(); :}
    | error bloque {: RESULT = Codigo.vacio(); :};

elemento_programa_cm ::= elemento_programa_cm:a elemento_programa:e {: RESULT = a.agregar(e); :}
    | {: RESULT = Codigo.vacio(); :};

programa ::= elemento_programa_cm:a funcion_principal:p elemento_programa_cm:b
        {: GestorTablas.cerrarGlobal(); RESULT = GeneradorTAC.programa(a, p, b); :};

expr_retorno ::= valor_asignable:e {: RESULT = e; :};

expr_modulo ::= expr_modulo:a OP_MODULO:o expr_multiplicativa:b
        {: String ty = Semantico.binaria(a, "mod", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "mod", b, ty, oleft, oright); :}
    | expr_multiplicativa:e {: RESULT = e; :};

expr_multiplicativa ::= expr_multiplicativa:a OP_MULT:o expr_aditiva:b
        {: String ty = Semantico.binaria(a, "*", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "*", b, ty, oleft, oright); :}
    | expr_multiplicativa:a OP_DIV_DECIMAL:o expr_aditiva:b
        {: String ty = Semantico.binaria(a, "/", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "/", b, ty, oleft, oright); :}
    | expr_multiplicativa:a OP_DIV_ENTERA:o expr_aditiva:b
        {: String ty = Semantico.binaria(a, "//", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "//", b, ty, oleft, oright); :}
    | expr_aditiva:e {: RESULT = e; :};

expr_aditiva ::= expr_aditiva:a  OP_SUMA:o expr_potencia:b
        {: String ty = Semantico.binaria(a, "+", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "+", b, ty, oleft, oright); :}
    | expr_aditiva:a  OP_RESTA:o expr_potencia:b
        {: String ty = Semantico.binaria(a, "-", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "-", b, ty, oleft, oright); :}
    | expr_potencia:e {: RESULT = e; :};

expr_potencia ::= expr_negativo:a OP_POTENCIA:o expr_potencia:b
        {: String ty = Semantico.binaria(a, "pot", b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, "pot", b, ty, oleft, oright); :}
    | expr_negativo:e {: RESULT = e; :};

expr_negativo ::= OP_RESTA:o literal_numerico:n
        {: String ty = Semantico.unaria("-", n, oleft, oright);
           RESULT = GeneradorTAC.unaria("-", n, ty, oleft, oright); :}
    | expr_primaria:e {: RESULT = e; :};

expr_primaria ::= literal:e {: RESULT = e; :}
    | ID:id
        {: String ty = Semantico.tipoDe(Semantico.usarVariable(id, idleft, idright));
           RESULT = GeneradorTAC.variable(id, ty, idleft, idright); :}
    | acceso_arreglo:e {: RESULT = e; :}
    | llamada_funcion:e {: RESULT = e; :}
    | expr_incremento:e {: RESULT = e; :}
    | expr_parentesis:e {: RESULT = e; :};

expr_parentesis ::= OPEN_PAREN valor_asignable:e CLOSE_PAREN {: RESULT = e; :};


literal_numerico ::= LIT_INT:v {: RESULT = GeneradorTAC.literal(v, Semantico.literal("int"), vleft, vright); :}
    | LIT_FLOAT:v {: RESULT = GeneradorTAC.literal(v, Semantico.literal("float"), vleft, vright); :};

argumento_funcion ::= valor_asignable:e {: RESULT = e; :};

lista_argumentos_funcion ::= argumento_funcion:e COMA lista_argumentos_funcion:l {: l.add(0, e); RESULT = l; :}
    | argumento_funcion:e {: RESULT = new java.util.ArrayList(); RESULT.add(e); :};

llamada_funcion ::= ID:id OPEN_PAREN lista_argumentos_funcion:l CLOSE_PAREN
        {: String ty = Semantico.llamada(id, l, idleft, idright);
           RESULT = GeneradorTAC.llamada(id, l, ty, idleft, idright); :}
    | ID:id OPEN_PAREN CLOSE_PAREN
        {: java.util.ArrayList l = new java.util.ArrayList();
           String ty = Semantico.llamada(id, l, idleft, idright);
           RESULT = GeneradorTAC.llamada(id, l, ty, idleft, idright); :};

literal ::= literal_numerico:e {: RESULT = e; :}
    | LIT_CHAR:v {: RESULT = GeneradorTAC.literal(v, Semantico.literal("char"), vleft, vright); :}
    | LIT_STRING:v {: RESULT = GeneradorTAC.literal(v, Semantico.literal("string"), vleft, vright); :}
    | TRUE:v {: RESULT = GeneradorTAC.literal("true", Semantico.literal("bool"), vleft, vright); :}
    | FALSE:v {: RESULT = GeneradorTAC.literal("false", Semantico.literal("bool"), vleft, vright); :};

indice ::= expr_modulo:e {: RESULT = e; :};

acceso_arreglo ::= ID:id OPEN_BRACKET indice:i CLOSE_BRACKET
        {: String ty = Semantico.acceso(id, i, idleft, idright);
           RESULT = GeneradorTAC.acceso(id, i, ty, idleft, idright); :};

valor_asignable ::= expr_modulo:e {: RESULT = e; :}
    | expr_relacional:e {: RESULT = e; :}
    | expr_logica:e {: RESULT = e; :};

creacion_simple ::= VAL var_arreglo:v FIN_SENTENCIA
        {: GestorTablas.declarar(v); Semantico.declaracion(v, null);
           RESULT = GeneradorTAC.declaracion(v, null); :}
    | VAL var_no_arreglo:v FIN_SENTENCIA
        {: GestorTablas.declarar(v); Semantico.declaracion(v, null);
           RESULT = GeneradorTAC.declaracion(v, null); :};

creacion_asign ::= VAL var_arreglo:v ASIGN valor_asignable:e FIN_SENTENCIA
        {: v.setInicializada(true); GestorTablas.declarar(v); Semantico.declaracion(v, e);
           RESULT = GeneradorTAC.declaracion(v, e); :}
    | VAL var_no_arreglo:v ASIGN valor_asignable:e FIN_SENTENCIA
        {: v.setInicializada(true); GestorTablas.declarar(v); Semantico.declaracion(v, e);
           RESULT = GeneradorTAC.declaracion(v, e); :};

asignacion ::= ID:id ASIGN valor_asignable:e FIN_SENTENCIA
        {: Semantico.asignacion(id, e, idleft, idright);
           RESULT = GeneradorTAC.asignacion(id, e); :};

dimension_arreglo ::= OPEN_BRACKET LIT_INT:n CLOSE_BRACKET {: RESULT = Integer.parseInt(n); :};

creacion_arreglo ::= VAL var_arreglo:v dimension_arreglo:d FIN_SENTENCIA
        {: v.setCategoria(Simbolo.Categoria.ARREGLO); v.setDimension(d); GestorTablas.declarar(v);
           java.util.ArrayList vals = new java.util.ArrayList();
           Semantico.creacionArreglo(v, vals);
           RESULT = GeneradorTAC.creacionArreglo(v, vals); :}
    | VAL var_arreglo:v dimension_arreglo:d ASIGN OPEN_LLAVES valores:vals CLOSE_LLAVES FIN_SENTENCIA
        {: v.setCategoria(Simbolo.Categoria.ARREGLO); v.setDimension(d); v.setInicializada(true); GestorTablas.declarar(v);
           Semantico.creacionArreglo(v, vals);
           RESULT = GeneradorTAC.creacionArreglo(v, vals); :};

asignacion_arreglo ::= acceso_arreglo:a ASIGN valor_asignable:e FIN_SENTENCIA
        {: Semantico.asignacionArreglo(a, e, aleft, aright);
           RESULT = GeneradorTAC.asignacionArreglo(a, e); :};

valor_arreglo ::= literal_numerico:e {: RESULT = e; :}
    | OP_RESTA:o literal_numerico:n
        {: String ty = Semantico.unaria("-", n, oleft, oright);
           RESULT = GeneradorTAC.unaria("-", n, ty, oleft, oright); :};

valores ::= valor_arreglo:x COMA valores:l {: l.add(0, x); RESULT = l; :}
    | valor_arreglo:x {: RESULT = new java.util.ArrayList(); RESULT.add(x); :};

sentencia_expr ::= valor_asignable:e FIN_SENTENCIA {: RESULT = GeneradorTAC.sentenciaExpr(e); :};

expr_incremento ::= ID:id OP_INCREMENTO
        {: String ty = Semantico.incremento(id, "++", idleft, idright);
           RESULT = GeneradorTAC.incremento(id, "++", ty, idleft, idright); :}
    | ID:id OP_DECREMENTO
        {: String ty = Semantico.incremento(id, "--", idleft, idright);
           RESULT = GeneradorTAC.incremento(id, "--", ty, idleft, idright); :};

arg_read ::= ID:id {: RESULT = id; :};

arg_write ::= literal:e {: RESULT = e; :}
    | OP_RESTA:o literal_numerico:n
        {: String ty = Semantico.unaria("-", n, oleft, oright);
           RESULT = GeneradorTAC.unaria("-", n, ty, oleft, oright); :}
    | ID:id
        {: String ty = Semantico.tipoDe(Semantico.usarVariable(id, idleft, idright));
           RESULT = GeneradorTAC.variable(id, ty, idleft, idright); :}
    | acceso_arreglo:e {: RESULT = e; :};

sent_read ::= READ OPEN_PAREN arg_read:a CLOSE_PAREN FIN_SENTENCIA
        {: Semantico.leer(a, aleft, aright);
           RESULT = GeneradorTAC.leer(a); :};

sent_write ::= WRITE:w OPEN_PAREN arg_write:e CLOSE_PAREN FIN_SENTENCIA
        {: Semantico.escribir(e, wleft, wright);
           RESULT = GeneradorTAC.escribir(e); :};

sent_return ::= RETURN:r expr_retorno:e FIN_SENTENCIA
        {: Semantico.retorno(e, rleft, rright);
           RESULT = GeneradorTAC.retorno(e); :};

sent_break ::= BREAK:b FIN_SENTENCIA
        {: Semantico.romper(bleft, bright);
           RESULT = GeneradorTAC.romper(); :};

sentencia_var ::= creacion_simple:c {: RESULT = c; :}
    | creacion_asign:c {: RESULT = c; :}
    | asignacion:c {: RESULT = c; :}
    | creacion_arreglo:c {: RESULT = c; :}
    | asignacion_arreglo:c {: RESULT = c; :}
    | sentencia_expr:c {: RESULT = c; :};

sentencia ::= sentencia_var:c {: RESULT = c; :}
    | sent_return:c {: RESULT = c; :}
    | sent_break:c {: RESULT = c; :}
    | sent_read:c {: RESULT = c; :}
    | sent_write:c {: RESULT = c; :}
    | sent_if:c {: RESULT = c; :}
    | sent_while:c {: RESULT = c; :}
    | sent_for:c {: RESULT = c; :}
    | bloque:b {: RESULT = b.getCodigo(); :};

lista_sentencias ::= sentencia:s lista_sentencias:l {: RESULT = Codigo.vacio().agregar(s).agregar(l); :}
    | error FIN_SENTENCIA lista_sentencias:l {: RESULT = l; :}
    | error bloque lista_sentencias:l {: RESULT = l; :}
    | {: RESULT = Codigo.vacio(); :};

op_orden ::= OP_MAYOR {: RESULT = ">"; :}
    | OP_MENOR {: RESULT = "<"; :}
    | OP_MAYOR_IGUAL {: RESULT = ">="; :}
    | OP_MENOR_IGUAL {: RESULT = "<="; :};

op_igualdad ::= OP_IGUAL {: RESULT = "=="; :}
    | OP_DIFERENTE {: RESULT = "!="; :};

operando_rel ::= OPEN_BRACKET valor_asignable:e CLOSE_BRACKET {: RESULT = e; :};

expr_rel_orden ::= operando_rel:a op_orden:o operando_rel:b
        {: String ty = Semantico.binaria(a, o, b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, o, b, ty, oleft, oright); :};

expr_rel_igualdad ::= operando_rel:a op_igualdad:o operando_rel:b
        {: String ty = Semantico.binaria(a, o, b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, o, b, ty, oleft, oright); :};

expr_relacional ::= expr_rel_orden:e {: RESULT = e; :}
    | expr_rel_igualdad:e {: RESULT = e; :};

op_logico ::= OP_AND {: RESULT = "λ"; :}
    | OP_OR {: RESULT = "θ"; :};

operando_logico ::= expr_parentesis:e {: RESULT = e; :}
    | expr_negacion:e {: RESULT = e; :};

expr_negacion ::= OP_NEGACION:o expr_parentesis:e
        {: String ty = Semantico.unaria("Σ", e, oleft, oright);
           RESULT = GeneradorTAC.unaria("Σ", e, ty, oleft, oright); :};

cadena_logica ::= cadena_logica:a op_logico:o operando_logico:b
        {: String ty = Semantico.binaria(a, o, b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, o, b, ty, oleft, oright); :}
    | operando_logico:a op_logico:o operando_logico:b
        {: String ty = Semantico.binaria(a, o, b, oleft, oright);
           RESULT = GeneradorTAC.binaria(a, o, b, ty, oleft, oright); :};

expr_logica ::= cadena_logica:e {: RESULT = e; :}
    | expr_negacion:e {: RESULT = e; :};

condicion ::= OPEN_PAREN valor_asignable:e CLOSE_PAREN {: Semantico.condicion(e); RESULT = e; :}
    | OPEN_PAREN:p error CLOSE_PAREN {: RESULT = Expr.error(pleft, pright); :};

sent_elif ::= ELIF:e condicion:c bloque:b
        {: GestorTablas.nombrar(b.getTabla(), "elif", eleft, eright);
           RESULT = new Rama(c, b.getCodigo()); :};

lista_elif ::= lista_elif:l sent_elif:r {: l.add(r); RESULT = l; :}
    | {: RESULT = new java.util.ArrayList(); :};

sent_else ::= ELSE:e bloque:b
        {: GestorTablas.nombrar(b.getTabla(), "else", eleft, eright);
           RESULT = b.getCodigo(); :};

sent_if ::= IF:i condicion:c bloque:b lista_elif:l sent_else:s
        {: GestorTablas.nombrar(b.getTabla(), "if", ileft, iright);
           RESULT = GeneradorTAC.si(c, b.getCodigo(), l, s); :}
    | IF:i condicion:c bloque:b lista_elif:l
        {: GestorTablas.nombrar(b.getTabla(), "if", ileft, iright);
           RESULT = GeneradorTAC.si(c, b.getCodigo(), l, null); :};

sent_while ::= WHILE:w condicion:c bloque:b
        {: GestorTablas.nombrar(b.getTabla(), "while", wleft, wright);
           RESULT = GeneradorTAC.mientras(c, b.getCodigo()); :};

for_inicio ::= VAL var_arreglo:v ASIGN valor_asignable:e
        {: v.setInicializada(true); GestorTablas.declarar(v); Semantico.declaracion(v, e);
           RESULT = GeneradorTAC.declaracion(v, e); :}
    | VAL var_no_arreglo:v ASIGN valor_asignable:e
        {: v.setInicializada(true); GestorTablas.declarar(v); Semantico.declaracion(v, e);
           RESULT = GeneradorTAC.declaracion(v, e); :}
    | ID:id ASIGN valor_asignable:e
        {: Semantico.asignacion(id, e, idleft, idright);
           RESULT = GeneradorTAC.asignacion(id, e); :};

for_condicion ::= valor_asignable:e {: Semantico.condicion(e); RESULT = e; :};

for_actualizacion ::= expr_modulo:e
        {: Semantico.actualizacionFor(e);
           RESULT = GeneradorTAC.sentenciaExpr(e); :}
    | ID:id ASIGN expr_modulo:e
        {: Semantico.asignacion(id, e, idleft, idright);
           RESULT = GeneradorTAC.asignacion(id, e); :};

sent_for ::= FOR:f OPEN_PAREN for_inicio:i FIN_SENTENCIA for_condicion:c FIN_SENTENCIA for_actualizacion:a CLOSE_PAREN bloque:b
        {: GestorTablas.cerrarFor(b.getTabla(), fleft, fright);
           RESULT = GeneradorTAC.para(i, c, a, b.getCodigo()); :};
